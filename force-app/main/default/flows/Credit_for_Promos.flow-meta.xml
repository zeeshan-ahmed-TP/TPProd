    </formulas>
    <formulas>
        <name>TotalAmountForCase</name>
        <dataType>String</dataType>
        <expression>&quot;Credit Request for $&quot; &amp; TEXT({!Create_Credit_Note.blng__TotalAmount__c})</expression>
    </formulas>
    <formulas>
        <name>TotalAmountToCredit</name>
        <dataType>Currency</dataType>
        <expression>{!Create_Credit_Note.blng__TotalAmount__c}</expression>
        <scale>2</scale>
    </formulas>
