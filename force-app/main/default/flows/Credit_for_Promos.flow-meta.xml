    </formulas>
    <formulas>
        <name>CaseDescription</name>
        <dataType>String</dataType>
        <expression>&quot;SUMMARY: 25% off for 2 months Promo Credit Request&quot; &amp; {!LineBreakTextTemplate} &amp;
&quot;Initial Invoice(s): &quot; &amp; {!Get_triggering_invoice.Name} &amp; {!LineBreakTextTemplate} &amp;
&quot;CREDIT BREAKDOWN: &quot; &amp; TEXT({!Create_Credit_Note.blng__TotalAmount__c}) &amp; &quot; x 1 month&quot;</expression>
    </formulas>
    <formulas>
        <name>CreditILSubtotal</name>
        <dataType>Number</dataType>
        <expression>{!Loop_Invoice_Lines.blng__Subtotal__c} * 0.25</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>TaxILCredit</name>
        <dataType>Number</dataType>
        <expression>{!Loop_Invoice_Lines.blng__TaxAmount__c} * 0.25</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Today</name>
        <dataType>DateTime</dataType>
