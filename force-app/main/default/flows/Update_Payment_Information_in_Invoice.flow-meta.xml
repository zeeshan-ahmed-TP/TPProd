                <elementReference>$Record.blng__PaymentMethod__r.blng__CardLastFour__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Payment_Date__c</field>
            <value>
                <elementReference>$Record.blng__PaymentDate__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Payment_Method__c</field>
            <value>
                <elementReference>$Record.blng__PaymentMethod__r.blng__PaymentType__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Transaction_Status__c</field>
            <value>
                <elementReference>$Record.blng__Transaction__r.blng__Status__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Transcation_ID__c</field>
            <value>
                <elementReference>$Record.blng__GatewayID__c</elementReference>
            </value>
        </inputAssignments>
        <object>blng__Invoice__c</object>
    </recordUpdates>
    <start>
        <locationX>305</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Update_Invoice_Information</targetReference>
        </connector>
        <filterFormula>AND( NOT(ISBLANK({!$Record.blng__Invoice__c})),
OR (IsNew(), 
ISCHANGED({!$Record.blng__PaymentDate__c}),
ISCHANGED({!$Record.blng__PaymentMethod__c}),
ISCHANGED({!$Record.blng__GatewayID__c}),
ISCHANGED({!$Record.blng__Transaction__r.blng__Status__c}),
ISCHANGED({!$Record.blng__PaymentAuthorization__c})
))</filterFormula>
        <object>blng__Payment__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
