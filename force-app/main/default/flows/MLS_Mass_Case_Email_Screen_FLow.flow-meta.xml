    <decisions>
        <name>Check_account_email_exists</name>
        <label>Check main contact email exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Add_Skipped_Accounts</targetReference>
        </defaultConnector>
