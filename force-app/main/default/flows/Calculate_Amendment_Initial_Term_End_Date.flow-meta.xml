    <formulas>
        <name>ContractStartDate</name>
        <dataType>Date</dataType>
        <expression>DATE(
YEAR( {!Get_Evergreen_Contract.StartDate}) + FLOOR( ( MONTH ( {!Get_Evergreen_Contract.StartDate}) + 12 - 1 ) / 12 ),
MOD( MONTH ( {!Get_Evergreen_Contract.StartDate}) + 12 - 1 +
IF( DAY ( {!Get_Evergreen_Contract.StartDate}) &gt; CASE( MOD( MONTH( {!Get_Evergreen_Contract.StartDate}) + 12 - 1, 12 ) + 1,
2, 28,
4, 30,
6, 30,
9, 30,
11, 30,
31 ), 1, 0 ), 12 ) + 1,
IF( DAY( {!Get_Evergreen_Contract.StartDate}) &gt; CASE( MOD( MONTH( {!Get_Evergreen_Contract.StartDate}) + 12 - 1, 12 ) + 1,
2, 28,
4, 30,
6, 30,
9, 30,
11, 30,
31 ),
1, DAY( {!Get_Evergreen_Contract.StartDate})
)
)
-1</expression>
    </formulas>
