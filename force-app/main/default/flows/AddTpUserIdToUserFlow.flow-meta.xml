    <textTemplates>
        <name>FaultEmail</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hello,&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;After the TPUserId edit, on the record with ID : {!$Record.Id} , we have encountered an error : {!$Flow.FaultMessage} .&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Please contact your admin.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thank you.&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>Nocontactemailtemplate</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hello,&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;The User licensing record numbered : {!$Record.Name} and ID : {!$Record.Id} is linked to an Agent account that has no contact as Main Account Owner.&lt;/p&gt;&lt;p&gt;The Agent Account ID is : {!$Record.Account__c}. Please edit that or contact your admin.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thank you.&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>NotificationEmail</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hello&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;The user with ID {!$User.Id} has updated the Federation ID for an inactive user with the name : {!GetTheUser.FirstName}  {!GetTheUser.LastName} , and with ID : {!GetTheUser.Id} . Please check if weather this user should be activated or not. &lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thank you.&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>UserwiththisTPUserIdexist</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hello,&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;You have added this TPUserId : {!$Record.TPUserID__c}  on the userLicensing : {!$Record.Id} , And we have found it used for the user : {!GetUserWithTpUserId.FirstName} &lt;span style=&quot;color: rgb(68, 68, 68); background-color: rgb(255, 255, 255);&quot;&gt;{!GetUserWithTpUserId.LastName} with ID : {!GetUserWithTpUserId.Id} . We have sent this email to let you know that we cannot use this TPUserId for the Main account owner linked to this Agent account. &lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); background-color: rgb(255, 255, 255);&quot;&gt;Please contact your admin.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); background-color: rgb(255, 255, 255);&quot;&gt;Thank you. &lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
