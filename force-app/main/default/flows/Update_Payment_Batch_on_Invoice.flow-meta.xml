    <decisions>
        <name>Check_Payment_Batch</name>
        <label>Check Payment Batch</label>
        <locationX>182</locationX>
        <locationY>395</locationY>
        <defaultConnector>
            <targetReference>Update_Payment_Batch_on_Invoice</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Ready for Write-Off</defaultConnectorLabel>
        <rules>
            <name>Ready_for_write_off</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.blng__PaymentBatch__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Batch 4</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Failed_Payment_Transactions__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>4.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.blng__DueDate__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Past30Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Write_off_Batch_on_Invoice</targetReference>
            </connector>
            <label>Ready for write-off</label>
        </rules>
    </decisions>
    <description>Update Payment Batch to Batch 4 IF Two payment Transactions Failed on an Invoice.</description>
    <environments>Default</environments>
    <formulas>
