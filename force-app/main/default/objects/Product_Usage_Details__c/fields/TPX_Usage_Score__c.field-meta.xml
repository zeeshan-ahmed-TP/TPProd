<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TPX_Usage_Score__c</fullName>
    <externalId>false</externalId>
    <formula>(IF(ROUND(TODAY()-Pendo_First_Visit_Date__c,0)&lt;30,(Pendo_TPX_Active_Days_Last_30__c/ROUND(TODAY()-Pendo_First_Visit_Date__c,0)),(Pendo_TPX_Active_Days_Last_30__c/30))
*60)
+
(
IF(ROUND(TODAY()-Pendo_First_Visit_Date__c,0)&lt;90,(Pendo_TPX_Active_Days_Last_90__c/ROUND(TODAY()-Pendo_First_Visit_Date__c,0)),(Pendo_TPX_Active_Days_Last_90__c/90))
*40)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>TPX Usage Score</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
