<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sales_MRR__c</fullName>
    <description>Custom Field in Development - attempting to express sales as simply as possible</description>
    <externalId>false</externalId>
    <formula>IF(ISPICKVAL(SBQQ__Quote__r.SBQQ__Type__c,&quot;Renewal&quot;),0,
(SBQQ__NetTotal__c
/ ( SBQQ__ProrateMultiplier__c * SBQQ__DefaultSubscriptionTerm__c )
)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Net Total as a Monthly Value multiplied by Proration Multiplier and Subscription Term</inlineHelpText>
    <label>Sales MRR</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
