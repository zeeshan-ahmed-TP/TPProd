<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Auto_Leads</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(TEXT(Auto_Leads_Contract_Term__c))),

    ISBLANK(Auto_Leads_Market_1__c),
    ISBLANK(Auto_Leads_Market_2__c),
    ISBLANK(Auto_Leads_Market_3__c)

)</errorConditionFormula>
    <errorMessage>Choose at least one Auto Leads Market field!...</errorMessage>
</ValidationRule>
