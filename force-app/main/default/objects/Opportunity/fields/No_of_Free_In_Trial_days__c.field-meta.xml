<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_of_Free_In_Trial_days__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
ISPICKVAL(  Campaign_12sg__c  ,&quot;30 Day Free Trial&quot;),
ROUND(Today() - DATEVALUE( CreatedDate ), 3),
null
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>No. of Free In Trial days</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
