<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Performance_Persona__c</fullName>
    <externalId>false</externalId>
    <formula>IF(OR(ISNULL(Lead_Enrichment_Data_Date__c),AND(ISBLANK(MLS_ID__c),ISBLANK(Office_Name__c),ISBLANK(MLS_System__c),Years_of_Experience__c=0,Historical_Transaction_Count__c=0)),&quot;&quot;,
IF(Years_of_Experience__c&lt;=1
	,IF(Transaction_Count_Last_12_Months__c=0,&quot;Underperforming&quot;,
		IF(Transaction_Count_Last_12_Months__c&lt;=2,&quot;Performing&quot;,
		IF(Transaction_Count_Last_12_Months__c&gt;2,&quot;Excelling&quot;,&quot;Other&quot;)))
	,
	IF(Years_of_Experience__c&lt;=3
		,IF(Transaction_Count_Last_12_Months__c&lt;=3,&quot;Underperforming&quot;,
			IF(Transaction_Count_Last_12_Months__c&lt;=10,&quot;Performing&quot;,
			IF(Transaction_Count_Last_12_Months__c&gt;10,&quot;Excelling&quot;,&quot;Other&quot;)))
	,
	IF(Years_of_Experience__c&gt;3
		,IF(Transaction_Count_Last_12_Months__c&lt;10,&quot;Underperforming&quot;,
			IF(Transaction_Count_Last_12_Months__c&lt;=20,&quot;Performing&quot;,
			IF(Transaction_Count_Last_12_Months__c&gt;20,&quot;Excelling&quot;,&quot;Other&quot;)))
	,&quot;Unknown&quot;)))
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Performance (Persona)</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
