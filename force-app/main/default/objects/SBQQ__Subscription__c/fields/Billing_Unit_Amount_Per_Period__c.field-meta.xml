<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Billing_Unit_Amount_Per_Period__c</fullName>
    <externalId>false</externalId>
    <formula>IF(ISPICKVAL(SBQQ__Product__r.Family,&apos;Zurple&apos;),SBQQ__CustomerPrice__c/SBQQ__ProrateMultiplier__c
, 

((SBQQ__NetPrice__c/IF(ISPICKVAL(SBQQ__PricingMethod__c,&quot;Block&quot;),SBQQ__Quantity__c,1)) / SBQQ__ProrateMultiplier__c)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>NET PRICE divided by PRORATION MULTIPLIER divided by BILLING PERIODS PER YEAR.
If PRICING METHOD is BLOCK then divide by QUANTITY.</inlineHelpText>
    <label>Billing Unit Amount Per Period</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
