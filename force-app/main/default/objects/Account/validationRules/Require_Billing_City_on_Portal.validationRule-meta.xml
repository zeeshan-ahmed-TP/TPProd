<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Billing_City_on_Portal</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISBLANK( BillingCity ), $Profile.Name = &quot;TP Customer Community Plus Login&quot;)</errorConditionFormula>
    <errorDisplayField>BillingCity</errorDisplayField>
    <errorMessage>City is required.</errorMessage>
</ValidationRule>
