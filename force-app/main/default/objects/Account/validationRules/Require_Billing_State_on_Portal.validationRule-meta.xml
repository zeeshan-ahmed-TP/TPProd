<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Billing_State_on_Portal</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISBLANK( BillingState ),$Profile.Name = &quot;TP Customer Community Plus Login&quot;)</errorConditionFormula>
    <errorDisplayField>Billing_State__c</errorDisplayField>
    <errorMessage>State is required.</errorMessage>
</ValidationRule>
