<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Postal_Code_on_Portal</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISBLANK( BillingPostalCode),$Profile.Name = &quot;TP Customer Community Plus Login&quot;)</errorConditionFormula>
    <errorDisplayField>BillingPostalCode</errorDisplayField>
    <errorMessage>Zip/Postal Code is required.</errorMessage>
</ValidationRule>
