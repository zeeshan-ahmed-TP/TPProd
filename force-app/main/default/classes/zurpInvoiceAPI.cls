@RestResource(urlMapping='/ZurpInvoiceAPI/*')
global with Sharing class zurpInvoiceAPI {
    public static RestRequest request = RestContext.request;
    public static RestResponse response = RestContext.response;
    
    @HttpPost
    global static void createInvoice(String accountId, String planId){
        Map<String, Object> responseData = new Map<String, Object>();
        response.addHeader('Content-Type', 'application/json');
        
        if(String.isEmpty(accountId) || String.isEmpty(planId)){
            responseData.put('status', 'failed');
        	responseData.put('message', 'Account and Plan Id is required!');
            response.statusCode = 201;
        	response.responseBody = Blob.valueOf(JSON.serialize(responseData));
            return;
        }
        blng__PaymentMethod__c paymentMethod = [Select Id, blng__Active__c,blng__AutoPay__c from blng__PaymentMethod__c where blng__AutoPay__c = true and blng__Active__c = true and blng__Account__c = :accountId Limit 1];
        if(paymentMethod == null){
            responseData.put('status', 'failed');
        	responseData.put('message', 'There is no active payment method with Auto Pay on this account');
            response.statusCode = 201;
        	response.responseBody = Blob.valueOf(JSON.serialize(responseData));
            return;
        }
        Id ZurpleRecTypeID = [Select Id, Name, DeveloperName from RecordType where SObjectType = 'blng__Invoice__c' and DeveloperName = 'Zurple'].Id;
        ZurpInvoice_Mapping__mdt[] lstZurpInvMapping = [Select MasterLabel, Price__c from ZurpInvoice_Mapping__mdt];
        blng__Invoice__c inv = new blng__Invoice__c();
        inv.blng__Account__c = accountId;
        inv.RecordTypeId = ZurpleRecTypeID;
        inv.Tax_Payer_Code__c = 'ZPI01';
        inv.blng__PaymentBatch__c = 'Zurple Batch';
        inv.blng__InvoiceStatus__c = 'Draft';
        inv.blng__InvoiceDate__c = Date.today();
        inv.blng__DueDate__c = Date.today();
        
        
        blng__InvoiceLine__c invLine = new blng__InvoiceLine__c();
        invLine.blng__Quantity__c = 1;
        invLine.blng__InvoiceLineStatus__c = 'Draft';
        invLine.blng__ChargeType__c = 'One-Time';
        invLine.blng__BillingFrequency__c = '1 Time Only';
        invLine.Name = 'Zurple Website Product';
        boolean plantIdMatched = false;
        for(ZurpInvoice_Mapping__mdt zurpInvMap : lstZurpInvMapping){
            if(zurpInvMap.MasterLabel == planId){
                plantIdMatched = true;
                invLine.blng__UnitPrice__c = zurpInvMap.Price__c;
        		invLine.blng__Subtotal__c = zurpInvMap.Price__c;
            }
        }
        if(!plantIdMatched){
            responseData.put('status', 'failed');
        	responseData.put('message', 'API call Please select a correct planId');
            response.statusCode = 201;
        	response.responseBody = Blob.valueOf(JSON.serialize(responseData));
            return;
        }
        invLine.blng__BillingRule__c = Label.Zurple_Billing_Rule;
        invLine.blng__BillingTreatment__c = Label.Zurple_Billing_Treatment;
        invLine.blng__LegalEntity__c = Label.Zurple_Legal_Entity;
        
        invLine.blng__BillingGLRule__c = Label.Zurple_Billing_GL_Rule;
        invLine.blng__TaxGLRule__c = Label.Zurple_Tax_GL_Rule;
        invLine.blng__BillingFinanceBook__c = Label.Zurple_Billing_Finance_Book;
        
        invLine.blng__BillingGLTreatment__c = Label.Zurple_Billing_GL_Treatment;
        invLine.blng__TaxGLTreatment__c= Label.Zurple_Tax_GL_Treatment;
        invLine.blng__BillingFinancePeriod__c = Label.Zurple_Billing_Finance_Period;
        
        try{
            insert inv;
            invLine.blng__Invoice__c = inv.Id;
            insert invLine;
            inv.blng__InvoiceStatus__c = 'Posted';
            update inv;
            responseData.put('status', 'success');
        	responseData.put('invoiceId', inv.Id);
         	response.statusCode = 200;
        	response.responseBody = Blob.valueOf(JSON.serialize(responseData));
            createPaymentSchedule();
        }catch(Exception ex){
            responseData.put('status', 'failed');
        	responseData.put('message', ex.toString());
            response.statusCode = 201;
        	response.responseBody = Blob.valueOf(JSON.serialize(responseData));
        }
    }
    
    @future(callout=true) 
    public static void createPaymentSchedule() {
        blng__PaymentScheduler__c paySch = new blng__PaymentScheduler__c();
            paySch.Name = 'Zurple Instant Batch ' + DateTime.now();
            paySch.blng__PaymentBatches__c = 'Zurple Batch';
            paySch.blng__PaymentGateway__c = Label.Zurple_Payment_Gateway;
            paySch.blng__PaymentType__c = 'Credit Card';
            paySch.blng__TargetDate__c = Date.Today();
            paySch.blng__Type__c = 'Once';
            paySch.blng__Startdateandtime__c = DateTime.now().addMinutes(1);
            insert paySch;
    }
    
