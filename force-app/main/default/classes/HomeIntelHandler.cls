public class HomeIntelHandler {
    
    @future (callout=true)
    public static void assignHomeIntelLicense(String Id, String licenseId, String subscriptionId){
        List<User_Licensing__c> existingLicenses = new List<User_Licensing__c>();
        if(licenseId != null){
            existingLicenses = [Select Id,Username__c,Account__c,Parent_Account__c,TPAccountId__c,TPUserID__c,Status__c,Product__c from User_Licensing__c 
                                where Account__c = :Id and Product__c =: ProductNames.TPCRM and Status__c = 'Fulfilled'];    
        }
        String endPointURL = Label.FB_Leads_URL + 'TpxFulfillment/AssignLicense';
        JSONGenerator jsonGen = JSON.createGenerator(true);
        jsonGen.writeStartObject();
        jsonGen.writeStringField('licenseType','35');
        jsonGen.writeStringField('userId',existingLicenses.get(0).TPUserID__c);
        jsonGen.writeEndObject();
        System.debug('json: ' + jsonGen.getAsString());
        HttpResponse res;
        if(Test.isRunningTest()){
            res = null;
        }else{ 
            res = sendApiCall(endPointURL, 'POST', jsonGen.getAsString()); 
            if(res != null && res.getStatus() == 'OK' && res.getStatusCode() == 200){
                User_Licensing__c uLicense = new User_Licensing__c(id = licenseID, Status__c = 'Fulfilled', TPAccountId__c = existingLicenses.get(0).TPAccountId__c, TPUserID__c = existingLicenses.get(0).TPUserID__c, TPSubscriptionID__c = subscriptionId);
                update uLicense;
            }else{
                User_Licensing__c uLicense = new User_Licensing__c(id = licenseID, Status__c = 'Failed', TPAccountId__c = existingLicenses.get(0).TPAccountId__c, TPUserID__c = existingLicenses.get(0).TPUserID__c, TPSubscriptionID__c = subscriptionId);
                update uLicense;
                System.debug('HomeIntelHandler: ' + res.getStatus() + ' Status Code: ' + res.getStatusCode());
        	}
        }
    }
    
    public static HttpResponse sendApiCall(String endPointURL,String method,String body){
        HttpRequest req = new HttpRequest(); HttpResponse res = new HttpResponse();
        req.setHeader('Content-Length', '0'); req.setHeader('Content-Type', 'application/json');
        req.setHeader('Authorization', 'Bearer ' + Label.FB_Leads_Token);
        req.setEndPoint(endPointURL);
        if(body != null)
        	req.setBody(body);
        req.setMethod(method);
        req.setTimeout(60000);
       
        HTTP http = new HTTP();          
        if(Test.isRunningTest()){
            return null;
        }else{
            res = http.send(req);            
        }
        System.debug('Response Status : '+res.getStatus());
        System.debug('Response Status Code : '+res.getStatusCode());
        System.debug('Response Body : '+res.getBody());
       
        return res;
    }
    
    @future (callout=true)
    public static void unAssignHomeIntelLicense(String licenseId, String userId){
        String endPointURL = Label.FB_Leads_URL + 'TpxFulfillment/UnAssignLicense';
        System.debug('Del URL: ' + endPointURL);
        JSONGenerator jsonGen = JSON.createGenerator(true);
        jsonGen.writeStartObject();
        jsonGen.writeStringField('licenseType','35');
        jsonGen.writeStringField('userId',userId);
        jsonGen.writeEndObject();
        System.debug('json: ' + jsonGen.getAsString());
        HttpResponse res;
        if(Test.isRunningTest()){
            res = null;
        }else{ res = sendApiCall(endPointURL, 'DELETE', jsonGen.getAsString()); }
    }
    
